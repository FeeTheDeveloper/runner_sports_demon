# Core local engine configuration
RUNNER_SCOUT_DB=.runner-scout.db
RUNNER_SCOUT_POLL_MS=30000
RUNNER_SCOUT_MARKET_LIMIT=250
RUNNER_PUBLISH_ENABLED=true
RUNNER_PUBLISH_TIMEOUT_MS=10000
RUNNER_HEARTBEAT_MS=30000

# Runner Site Supabase (shared cloud data plane) — optional cloud publishing only.
RUNNER_SITE_SUPABASE_URL=
RUNNER_SITE_SUPABASE_SERVICE_ROLE_KEY=

# Kalshi (primary prediction-market integration)
KALSHI_API_KEY=
KALSHI_API_KEY_ID=
KALSHI_API_SECRET=
KALSHI_PRIVATE_KEY_BASE64=
KALSHI_REST_BASE=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2

# Polymarket (optional and disabled by default)
RUNNER_ENABLE_POLYMARKET=false
POLYMARKET_API_KEY=
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ESPN CFB live scoreboard/summary ingestion (public machine-readable feed)
ESPN_CFB_BASE=https://site.api.espn.com/apis/site/v2/sports/football/college-football
RUNNER_ESPN_POLL_MS=10000
RUNNER_ESPN_SCHEDULE_CACHE_MS=60000

# The Odds API v4 CFB sportsbook ingestion (disabled honestly when key is absent)
ODDS_API_KEY=
ODDS_API_BASE=https://api.the-odds-api.com/v4
ODDS_API_REGIONS=us
ODDS_API_MARKETS=h2h,spreads,totals
RUNNER_ODDS_POLL_MS=20000
RUNNER_ODDS_QUOTA_BACKOFF_MS=3600000
RUNNER_PROVIDER_MAX_BACKOFF_MS=300000

# Optional webhook integration
DISCORD_WEBHOOK=

# ESPN authoritative football scoreboards (optional endpoint overrides for approved infrastructure/tests)
ESPN_CFB_SCOREBOARD_URL=https://site.api.espn.com/apis/site/v2/sports/football/college-football/scoreboard
ESPN_NFL_SCOREBOARD_URL=https://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard
# Legacy CFB override retained for backwards compatibility.
ESPN_SCOREBOARD_URL=

# Optional. Default target/source dirs for `runner-scout export`/`import` when no dir arg is
# passed — e.g. a locally-synced shared Drive folder. Leave unset to default to ./exports.
RUNNER_SCOUT_EXPORT_DIR=
RUNNER_SCOUT_IMPORT_DIR=

# Runner API security (server auth + CORS)
# ****** required on mutating API endpoints (POST /observations, POST /totals/evaluate).
# Fail-closed: if this is left unset, those endpoints reject every request with 503 rather than
# allowing them through unauthenticated. Set a long random value before relying on them.
RUNNER_API_BEARER_TOKEN=
# Comma-separated list of origins allowed to receive CORS headers from the API (e.g.
# https://runnersports.example,http://localhost:3000). A literal "*" entry allows any origin.
# Leave unset to send no Access-Control-Allow-Origin header at all (no permissive CORS by default).
RUNNER_API_ALLOWED_ORIGINS=
